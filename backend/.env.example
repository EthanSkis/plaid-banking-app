# Plaid (dashboard.plaid.com -> Developers -> Keys)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox            # sandbox | production
PLAID_REDIRECT_URI=          # optional, only for OAuth banks that need it

# Postgres (Neon via Vercel Marketplace sets this automatically)
DATABASE_URL=

# Generate each with: openssl rand -base64 32
ENCRYPTION_KEY=              # encrypts Plaid access tokens at rest. LOSE THIS = relink every bank.
SESSION_SECRET=              # signs app session tokens
CRON_SECRET=                 # Vercel sends this to /api/cron/daily

# Must match the iOS bundle identifier (used to verify Sign in with Apple tokens)
APPLE_BUNDLE_ID=com.yourname.plaidbank
